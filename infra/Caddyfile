# Elektron kutubxona — Caddy konfiguratsiyasi
# Reja: D ilovasi. Himoyalangan fayl yetkazish: Django ruxsat beradi,
# baytlarni Caddy uzatadi (X-Accel-Redirect naqshi, intercept orqali).

{
	email {$ACME_EMAIL}
	# IP orqali kirilganda brauzer SNI yubormaydi — qaysi sertifikat berilishi
	default_sni {$DEFAULT_SNI}
}

# Sayt qoidalari (domen va IP bloklari uchun umumiy)
(sayt) {
	encode zstd gzip

	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Fon rasmlari, ukki va Next optimallashtirgan rasmlar kamdan-kam o'zgaradi:
	# brauzer 1 kun keshda saqlaydi (Next public/ uchun max-age=0 beradi — har safar qayta so'rardi)
	@rasmlar path /rasm/* /_next/image*
	header @rasmlar {
		defer
		Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
	}

	# --- Himoyalangan kitob fayllari ---
	# Django tiketni tekshiradi va X-Accel-Redirect qaytaradi.
	# Caddy faylni /data/books dan o'zi uzatadi (Range qo'llab-quvvatlanadi).
	handle /api/v1/files/* {
		reverse_proxy web:8000 {
			@accel header X-Accel-Redirect *
			handle_response @accel {
				root * /data
				rewrite * {rp.header.X-Accel-Redirect}
				method GET
				file_server
			}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# --- Django API va admin ---
	handle /api/* {
		reverse_proxy web:8000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
	handle /{$ADMIN_PATH}/* {
		reverse_proxy web:8000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# --- Statik va ochiq media (muqovalar) ---
	handle /static/* {
		root * /srv
		file_server
	}
	handle /media/* {
		root * /srv
		file_server
	}

	# --- Qolgan hammasi: Next.js ---
	handle {
		reverse_proxy next:3000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
}

# Asosiy domen — Let's Encrypt sertifikati avtomatik (DNS A-yozuvi kerak)
{$SITE_ADDRESS} {
	import sayt
}

# IP orqali kirish — Let's Encrypt qisqa muddatli (shortlived) IP sertifikati;
# bermasa ichki sertifikatga qaytadi (sayt baribir ishlaydi)
{$IP_ADDRESS:127.0.0.1} {
	tls {
		issuer acme {
			email {$ACME_EMAIL}
			profile shortlived
		}
		issuer internal
	}
	import sayt
}
